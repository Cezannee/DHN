flowchart TB
    USERS["USERS
    PK id
    UK email
    username, name, first_name, last_name
    password, mobile, gender, date_of_birth
    address, bio, social_profiles, avatar
    status, last_ip, login_count, last_login
    FK created_by, updated_by, deleted_by -> users.id"]

    SESSIONS["SESSIONS
    PK id
    FK user_id -> users.id
    ip_address, user_agent, payload, last_activity"]

    PASSWORD["PASSWORD_RESET_TOKENS
    PK email
    token, created_at"]

    PROVIDERS["USER_PROVIDERS
    PK id
    FK user_id -> users.id
    provider, provider_id, avatar"]

    ROLES["ROLES
    PK id
    UK name + guard_name
    created_at, updated_at"]

    PERMISSIONS["PERMISSIONS
    PK id
    UK name + guard_name
    created_at, updated_at"]

    MHR["MODEL_HAS_ROLES
    PK role_id + model_id + model_type
    FK role_id -> roles.id
    model_id references users.id when model_type = App\\Models\\User"]

    MHP["MODEL_HAS_PERMISSIONS
    PK permission_id + model_id + model_type
    FK permission_id -> permissions.id
    model_id references users.id when model_type = App\\Models\\User"]

    RHP["ROLE_HAS_PERMISSIONS
    PK permission_id + role_id
    FK permission_id -> permissions.id
    FK role_id -> roles.id"]

    MEDIA["MEDIA
    PK id
    UK uuid
    model_type, model_id
    collection_name, name, file_name, mime_type
    disk, conversions_disk, size, JSON metadata"]

    NOTIF["NOTIFICATIONS
    PK id UUID
    type, notifiable_type, notifiable_id
    data, read_at"]

    ACTIVITY["ACTIVITY_LOG
    PK id
    subject_type, subject_id
    causer_type, causer_id
    event, properties, batch_uuid"]

    USERS --> SESSIONS
    USERS --> PROVIDERS
    USERS --> MHR
    USERS --> MHP
    USERS -. polymorphic .-> MEDIA
    USERS -. polymorphic .-> NOTIF
    USERS -. polymorphic .-> ACTIVITY
    ROLES --> MHR
    ROLES --> RHP
    PERMISSIONS --> MHP
    PERMISSIONS --> RHP
    USERS -. email .-> PASSWORD
